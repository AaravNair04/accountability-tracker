{
  "manifest_version": 3,
  "name": "Accountability Tracker",
  "version": "0.1.0",
  "description": "Tracks active usage of selected websites.",

  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "http://localhost:3000/*"
  ],

  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Accountability Tracker",
    "default_popup": "src/popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/devices/link*"
      ],
      "js": [
        "dist/linkBridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
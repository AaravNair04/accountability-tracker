{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "src/lib/usage/activitySegments.ts",
    "src/lib/reports/reportTime.ts",
    "src/lib/trackedSiteRules.ts",
    "src/lib/dataRetentionRules.ts",
    "tests/**/*.test.ts"
  ]
}
